
WEB_HOST_NAME=healthdata-local.com
WEB_PORT=8092
WEB_HOST=${WEB_HOST_NAME}:${WEB_PORT}
# This is the server URL for healthdata
HEALTHDATA_SERVER_NAME=http://healthdata-local.com
# Set to false for local development (http scheme)
HEALTHDATA_ACCESS_COOKIE_SECURE=false
# Domain used for cookies
HEALTHDATA_COOKIES_DOMAIN=healthdata-local.com
# Keycloak Docker intercontainer address
KEYCLOAK_DOCKER_ADDRESS=http://${WEB_HOST}/keycloak/
# EU Login Server address
EU_LOGIN_SERVER_ADDRESS=https://eu-login.dev.data.health.europa.eu:7002

VITE_API_BASE_URL=http://${WEB_HOST}/hub/api/search/
VITE_API_HUB_URL=http://${WEB_HOST}/hub/api/repo/
VITE_API_QUALITY_BASE_URL=http://${WEB_HOST}/mqa/api/cache/
VITE_API_SIMILARITY_BASE_URL=http://${WEB_HOST}/mqa/api/similarities/
VITE_API_FILE_UPLOAD_URL=http://${WEB_HOST}/hub/api/store/
VITE_API_SPARQL_URL=http://${WEB_HOST}/api/virtuoso/sparql

VITE_API_CORSPROXY_API_URL=http://${WEB_HOST}/geoviewer/proxy
VITE_DATA_ACCESS_URL=http://${WEB_HOST}/healthData
VITE_DATA_AUTH_URL=http://${WEB_HOST}/auth/api
VITE_STATISTICS_URL=http://${WEB_HOST}/catalogue-statistics/api

EULOGIN_REDIRECT_URI=http://${WEB_HOST}/auth/api/callback

APP_ROOT=http://${WEB_HOST}/